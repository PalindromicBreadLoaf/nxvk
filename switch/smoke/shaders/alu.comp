#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) buffer Out { vec4 data[]; };

void main()
{
   uint id = gl_GlobalInvocationID.y * 256u + gl_GlobalInvocationID.x;
   vec4 x = vec4(vec2(gl_GlobalInvocationID.xy), float(id), 1.0) * 0.0001;
   for (int i = 0; i < 64; i++)
      x = fract(x * 1.017 + x.yzwx);
   data[id] = x;
}
