# Meson CROSS file for the Rust half of the build (NVK's NAK compiler + bindgen).

[binaries]
rust    = ['/work/switch/rust/rustc-switch.sh']
bindgen = 'bindgen'

[properties]
bindgen_clang_arguments = ['--target=aarch64-none-elf', '-isystem', '/opt/devkitpro/devkitA64/aarch64-none-elf/include', '-isystem', '/opt/devkitpro/libnx/include', '-D__SWITCH__', '-D_GNU_SOURCE']
